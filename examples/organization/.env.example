# Copy to examples/organization/.env (ignored by git) and fill in. Every value
# is optional: setup.sh skips the steps it has no value for and says so.

# The enclos binary, if it is not on PATH.
# ENCLOS=~/.cargo/bin/enclos

# Sandbox names (a lowercase letter, then lowercase letters, digits, hyphens).
# MANAGER=manager
# DEV=dev
# COMMUNITY=community

# Manager: a Telegram bot that answers only you. Get the token from @BotFather
# and your numeric user id from @userinfobot.
MANAGER_TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Community manager: a second Telegram bot, for a group anyone can talk to.
COMMUNITY_TELEGRAM_BOT_TOKEN=
# The group's chat id (a negative number). Empty: any group the bot is added to.
COMMUNITY_GROUP_CHAT_ID=
# true: answer anyone in private chats too. false: only TELEGRAM_USER_ID.
COMMUNITY_OPEN=true
# The remote MCP server the developer builds and maintains (https://...).
# Its host is the only task-specific destination the community sandbox gets.
COMMUNITY_MCP_URL=

# Developer: GitHub and Supabase, over HTTPS through the sandbox's proxy.
# A fine-grained token limited to the repositories the developer works on.
DEV_GITHUB_TOKEN=
# From https://supabase.com/dashboard/account/tokens
DEV_SUPABASE_ACCESS_TOKEN=
# The Supabase project the developer deploys the MCP server to (its ref).
DEV_SUPABASE_PROJECT_REF=
