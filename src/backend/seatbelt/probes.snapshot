network | an unlisted port through the proxy
  script: /usr/bin/curl -s -o /dev/null -w '%{http_connect}' --max-time 15 --noproxy '' https://probe.enclos.invalid:8443/
  proof: the proxy refuses
network | loopback through the proxy
  script: /usr/bin/curl -s -o /dev/null -w '%{http_connect}' --max-time 15 --noproxy '' https://127.0.0.1/
  proof: the proxy refuses
network | the cloud metadata address through the proxy
  script: /usr/bin/curl -s -o /dev/null -w '%{http_connect}' --max-time 15 --noproxy '' https://169.254.169.254/
  proof: the proxy refuses
network | a private address through the proxy
  script: /usr/bin/curl -s -o /dev/null -w '%{http_connect}' --max-time 15 --noproxy '' https://10.0.0.1/
  proof: the proxy refuses
network | a direct connection, around the proxy
  script: /usr/bin/nc -z -w 3 1.1.1.1 443
  proof: fails
  control: /usr/bin/nc -z -w 3 1.1.1.1 443
network | the proxy port on IPv6 loopback reaches only the proxy
  script: /usr/bin/curl -s -o /dev/null -w '%{http_connect}' --max-time 15 --noproxy '' --proxy 'http://[::1]:41001' https://probe.enclos.invalid:8443/; echo " $?"
  proof: only the proxy
  control: /usr/bin/curl -s -o /dev/null -w '%{http_connect}' --max-time 15 --noproxy '' --proxy 'http://[::1]:41001' https://probe.enclos.invalid:8443/; echo " $?"
network | bind a TCP port on 127.0.0.1
  script: /usr/bin/perl -MSocket=:all -e 'socket(my $s, AF_INET, SOCK_STREAM, 0) or die "socket: $!\n"; bind($s, sockaddr_in(0, inet_aton("127.0.0.1"))) or die "bind: $!\n"'
  proof: fails with bind: Operation not permitted
  control: /usr/bin/perl -MSocket=:all -e 'socket(my $s, AF_INET, SOCK_STREAM, 0) or die "socket: $!\n"; bind($s, sockaddr_in(0, inet_aton("127.0.0.1"))) or die "bind: $!\n"'
network | bind a TCP port on [::1]
  script: /usr/bin/perl -MSocket=:all -e 'socket(my $s, AF_INET6, SOCK_STREAM, 0) or die "socket: $!\n"; bind($s, pack_sockaddr_in6(0, inet_pton(AF_INET6, "::1"))) or die "bind: $!\n"'
  proof: fails with bind: Operation not permitted
  control: /usr/bin/perl -MSocket=:all -e 'socket(my $s, AF_INET6, SOCK_STREAM, 0) or die "socket: $!\n"; bind($s, pack_sockaddr_in6(0, inet_pton(AF_INET6, "::1"))) or die "bind: $!\n"'
