  "after_home_mask": [
    "--dev",
    "/dev",
    "--proc",
    "/proc",
    "--tmpfs",
    "/tmp",
    "--tmpfs",
    "/var/tmp",
    "--tmpfs",
    "/run",
    "--tmpfs",
    "/dev/shm",
    "--bind",
    "/nonexistent-enclos-test/alice/.enclos/sandboxes/home/home",
    "/nonexistent-enclos-test/alice/.enclos/sandboxes/home/home",
    "--ro-bind",
    "/nonexistent-enclos-test/alice/.enclos/run/home/visible",
    "/nonexistent-enclos-test/alice/.enclos/run/home/visible",
    "--ro-bind",
    "/nonexistent-enclos-test/alice/.enclos/sandboxes/home/compiled",
    "/nonexistent-enclos-test/alice/.enclos/sandboxes/home/compiled",
    "--ro-bind-try",
    "/nonexistent-enclos-test/alice/.enclos/sandboxes/home/secrets",
    "/nonexistent-enclos-test/alice/.enclos/sandboxes/home/secrets",
    "--unshare-user",
    "--disable-userns",
    "--unshare-pid",
    "--unshare-net",
    "--unshare-ipc",
    "--unshare-uts",
    "--unshare-cgroup-try",
    "--die-with-parent",
    "--clearenv",
    "--chdir",
    "/nonexistent-enclos-test/alice/.enclos/sandboxes/home/home"
  ],
  "landlock": {
    "read": [
      "/"
    ],
    "execute": [
      "/usr",
      "/bin",
      "/sbin",
      "/lib",
      "/lib32",
      "/lib64",
      "/libx32",
      "/opt",
      "/snap",
      "/nonexistent-enclos-test/alice/.enclos/sandboxes/home/home"
    ],
    "write": [
      "/nonexistent-enclos-test/alice/.enclos/sandboxes/home/home",
      "/tmp",
      "/var/tmp",
      "/dev/shm"
    ],
    "devices": [
      "/dev"
    ],
    "proc_write": [
      "/proc"
    ],
    "scoped": [
      "abstract_unix_socket",
      "signal"
    ]
  },
  "seccomp": {
    "errno": "EPERM",
    "deny": [
      "keyctl",
      "add_key",
      "request_key",
      "bpf",
      "perf_event_open",
      "userfaultfd",
      "mount",
      "umount2",
      "pivot_root",
      "move_mount",
      "open_tree",
      "fsopen",
      "fsconfig",
      "fsmount",
      "fspick",
      "mount_setattr",
      "setns",
      "kexec_load",
      "kexec_file_load",
      "init_module",
      "finit_module",
      "delete_module",
      "reboot",
      "swapon",
      "swapoff",
      "acct",
      "quotactl",
      "quotactl_fd",
      "ioperm",
      "iopl",
      "open_by_handle_at",
      "uselib",
      "io_uring_setup",
      "io_uring_enter",
      "io_uring_register"
    ],
    "ioctl": {
      "TIOCLINUX": 21532,
      "TIOCSTI": 21522
    },
    "clone_flags": {
      "CLONE_NEWCGROUP": 33554432,
      "CLONE_NEWIPC": 134217728,
      "CLONE_NEWNET": 1073741824,
      "CLONE_NEWNS": 131072,
      "CLONE_NEWPID": 536870912,
      "CLONE_NEWTIME": 128,
      "CLONE_NEWUSER": 268435456,
      "CLONE_NEWUTS": 67108864
    },
    "enosys": [
      "clone3"
    ]
  },
  "relay": {
    "port": 41001,
    "socket": "/nonexistent-enclos-test/alice/.enclos/run/home/visible/proxy.sock"
  },
  "unenforced": [
    {
      "field": "network.listen",
      "when": "every host",
      "why": "nothing refuses bind or listen in a session's own network namespace"
    }
  ]
}
