    "mounts": [
      "--dev",
      "/dev",
      "--proc",
      "/proc",
      "--tmpfs",
      "/tmp",
      "--tmpfs",
      "/var/tmp",
      "--tmpfs",
      "/run",
      "--tmpfs",
      "/dev/shm",
      "--tmpfs",
      "/srv/alice-data/enclos",
      "--tmpfs",
      "/srv/alice-data/systemd/user",
      "--bind",
      "/srv/alice-data/enclos/sandboxes/home/home",
      "/srv/alice-data/enclos/sandboxes/home/home",
      "--bind-try",
      "/nonexistent-enclos-test/alice/proj",
      "/nonexistent-enclos-test/alice/proj",
      "--ro-bind",
      "/srv/alice-data/enclos/run/home/visible",
      "/srv/alice-data/enclos/run/home/visible",
      "--ro-bind",
      "/srv/alice-data/enclos/sandboxes/home/compiled",
      "/srv/alice-data/enclos/sandboxes/home/compiled",
      "--ro-bind-try",
      "/srv/alice-data/enclos/sandboxes/home/secrets",
      "/srv/alice-data/enclos/sandboxes/home/secrets",
      "--remount-ro",
      "/srv/alice-data/enclos",
      "--remount-ro",
      "/srv/alice-data/systemd/user"
    ],
    "grant_masks": {
      "unmovable": [
        "/nonexistent-enclos-test/alice/proj/config"
      ],
      "in_sandbox_home": [],
      "in_workspace": [
        "/nonexistent-enclos-test/alice/proj/config/.env"
      ],
      "workspaces": [
        "/nonexistent-enclos-test/alice/proj"
      ]
    },
    "options": [
      "--unshare-user",
      "--disable-userns",
      "--unshare-pid",
      "--as-pid-1",
      "--unshare-net",
      "--unshare-ipc",
      "--unshare-uts",
      "--unshare-cgroup-try",
      "--die-with-parent",
      "--chdir",
      "/srv/alice-data/enclos/sandboxes/home/home"
    ]
  },
  "landlock": {
    "read": [
      "/"
    ],
    "execute": [
      "/usr",
      "/bin",
      "/sbin",
      "/lib",
      "/lib32",
      "/lib64",
      "/libx32",
      "/opt",
      "/snap",
      "/srv/alice-data/enclos/sandboxes/home/home"
    ],
    "write": [
      "/srv/alice-data/enclos/sandboxes/home/home",
      "/nonexistent-enclos-test/alice/proj",
      "/tmp",
      "/var/tmp",
      "/dev/shm"
    ],
    "devices": [
      "/dev"
    ],
    "proc_write": [
      "/proc"
    ],
    "scoped": [
      "abstract_unix_socket",
      "signal"
    ]
  },
  "seccomp": {
    "errno": "EPERM",
    "deny": [
      "keyctl",
      "add_key",
      "request_key",
      "bpf",
      "perf_event_open",
      "userfaultfd",
      "mount",
      "umount2",
      "pivot_root",
      "move_mount",
      "open_tree",
      "fsopen",
      "fsconfig",
      "fsmount",
      "fspick",
      "mount_setattr",
      "setns",
      "kexec_load",
      "kexec_file_load",
      "init_module",
      "finit_module",
      "delete_module",
      "reboot",
      "swapon",
      "swapoff",
      "acct",
      "quotactl",
      "quotactl_fd",
      "ioperm",
      "iopl",
      "open_by_handle_at",
      "uselib",
      "io_uring_setup",
      "io_uring_enter",
      "io_uring_register"
    ],
    "ioctl": {
      "TIOCLINUX": 21532,
      "TIOCSTI": 21522
    },
    "clone_flags": {
      "CLONE_NEWCGROUP": 33554432,
      "CLONE_NEWIPC": 134217728,
      "CLONE_NEWNET": 1073741824,
      "CLONE_NEWNS": 131072,
      "CLONE_NEWPID": 536870912,
      "CLONE_NEWTIME": 128,
      "CLONE_NEWUSER": 268435456,
      "CLONE_NEWUTS": 67108864
    },
    "enosys": [
      "clone3"
    ],
    "socket_families": {
      "AF_INET": 2,
      "AF_INET6": 10,
      "AF_NETLINK": 16,
      "AF_UNIX": 1
    }
  },
  "relay": {
    "port": 41001,
    "socket": "/srv/alice-data/enclos/run/home/visible/proxy.sock",
    "log": "/tmp/enclos-relay.log"
  },
  "unenforced": [
    {
      "field": "network.listen",
      "when": "every host",
      "why": "nothing refuses bind or listen in a session's own network namespace"
    }
  ]
}
