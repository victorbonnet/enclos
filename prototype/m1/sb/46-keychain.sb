;; The Keychain: securityd (file-based keychains) and secd (data-protection
;; keychain). The keychain files themselves are on the read deny list.
(deny mach-lookup (with message (param "SANDBOX_TAG"))
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.securityd.general")
  (global-name "com.apple.secd")
  (global-name "com.apple.security.agent")
  (global-name "com.apple.security.authhost"))
